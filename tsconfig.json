{
  "compilerOptions": {
    "outDir": "./lib",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2021",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "node16",
    "sourceMap": true,
    "declaration": true,
    "lib": ["es2021"]
  },
  "include": ["./src/**/*"]
}